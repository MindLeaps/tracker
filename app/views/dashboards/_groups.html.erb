<section class="min-w-0 rounded-xl border border-gray-100 bg-white p-5 shadow-sm" aria-labelledby="group-overview-title">
  <h2 id="group-overview-title" class="text-lg font-semibold text-purple-900"><%= t(:dashboard_group_overview) %></h2>
  <% overview = @dashboard.group_overview %>
  <% if overview.empty? %>
    <p class="mt-4 text-gray-600"><%= t(:dashboard_no_groups) %></p>
  <% else %>
    <ul class="mt-4 max-h-96 space-y-3 overflow-y-auto">
      <% overview.each do |entry| %>
        <li class="rounded-lg border border-purple-100 bg-purple-50/50 p-4">
          <%= link_to entry[:group].group_name, group_path(entry[:group]), class: 'font-semibold text-purple-900 hover:underline' %>
          <dl class="mt-3 grid grid-cols-2 gap-3">
            <div><dt class="text-xs text-gray-600"><%= t(:dashboard_lessons) %></dt><dd class="mt-1 text-xl font-semibold text-gray-900"><%= entry[:lessons] %></dd></div>
            <div><dt class="text-xs text-gray-600"><%= t(:dashboard_students) %></dt><dd class="mt-1 text-xl font-semibold text-gray-900"><%= entry[:students] %></dd></div>
          </dl>
          <p class="mt-3 text-xs text-gray-600"><%= t(:dashboard_latest_lesson) %>: <%= entry[:latest] ? l(entry[:latest], format: :long) : t(:dashboard_no_recorded_lessons) %></p>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
