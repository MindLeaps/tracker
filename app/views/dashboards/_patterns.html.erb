<% improving = direction == :improvement %>
<section class="min-w-0">
  <h2 class="text-lg font-semibold text-purple-900"><%= title %></h2>
  <p class="mt-2 text-sm text-gray-600"><%= t(:dashboard_chapter_patterns, chapter: @chapter.chapter_name, period: dashboard_date_range(@dashboard.history_period)) %></p>
  <% if patterns.empty? %>
    <p class="mt-4 rounded-xl border border-gray-100 bg-white p-5 text-gray-600"><%= empty %></p>
  <% else %>
    <ul class="mt-4 grid grid-cols-1 gap-4 2xl:grid-cols-2">
      <% patterns.each do |pattern| %>
        <li class="min-w-0 rounded-xl border p-5 shadow-sm <%= improving ? 'border-green-200 bg-green-50' : 'border-red-200 bg-red-50' %>">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <%= link_to dashboard_student_name(pattern), reports_student_path(pattern[:student_id]), class: 'break-words text-base font-semibold text-gray-900 hover:underline' %>
              <p class="mt-1 text-xs text-gray-600"><%= pattern.values_at(:group_name, :subject_name).join(' · ') %></p>
            </div>
            <span class="shrink-0 rounded-full px-3 py-1 text-sm font-semibold <%= improving ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
              <%= t(improving ? :dashboard_score_increase : :dashboard_score_decrease, count: pattern[:change]) %>
            </span>
          </div>
          <div class="mt-4 flex items-center justify-between gap-3">
            <h3 class="text-sm font-semibold text-gray-800"><%= pattern[:skill_name] %></h3>
            <% coordinates = dashboard_trend_coordinates(pattern[:evidence]) %>
            <svg viewBox="0 0 100 40" width="100" height="40" class="shrink-0 <%= improving ? 'text-green-600' : 'text-red-500' %>" aria-hidden="true" focusable="false">
              <polyline points="<%= coordinates.map { |point| point.join(',') }.join(' ') %>" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
              <% coordinates.each do |x, y| %>
                <circle cx="<%= x %>" cy="<%= y %>" r="3.5" fill="currentColor" />
              <% end %>
            </svg>
          </div>
          <ol class="mt-3 grid grid-cols-3 gap-2">
            <% pattern[:evidence].each do |assessment| %>
              <li class="rounded-lg bg-white/70 px-2 py-3 text-center">
                <strong class="block text-xl text-gray-900"><%= assessment[:mark] %></strong>
                <span class="mt-1 block text-xs text-gray-600"><%= l(assessment[:lesson_date], format: :short) %></span>
              </li>
            <% end %>
          </ol>
        </li>
      <% end %>
    </ul>
  <% end %>
  <p class="mt-4 text-xs text-gray-500"><%= t(:dashboard_pattern_explanation) %></p>
</section>
