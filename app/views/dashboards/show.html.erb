<% content_for :title, t(:dashboard) %>
<%= render LayoutComponents::HeaderComponent.new(current_user: current_user, tabs: [{ title: t(:dashboard), href: '' }], buttons: []) %>

<main class="w-full min-w-0 p-4 sm:p-6 lg:p-8">
  <% if @dashboard.nil? %>
    <section class="rounded-lg bg-white p-6 shadow-sm sm:p-10">
      <h1 class="text-2xl font-semibold text-purple-900"><%= t(:dashboard_welcome) %></h1>
      <p class="mt-3 text-gray-700"><%= t(:dashboard_setup) %></p>
      <%= link_to t(:dashboard_choose_chapter), profile_path, class: 'normal-button mt-6 inline-block' %>
    </section>
  <% else %>
    <header class="mb-6">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h1 class="text-2xl font-semibold text-purple-900"><%= t(:dashboard_heading, chapter: @chapter.chapter_name) %></h1>
        <%= link_to t(:dashboard_change_chapter), profile_path, class: 'text-sm text-purple-800 underline' %>
      </div>
      <p class="mt-2 text-gray-700"><%= dashboard_date_range(@dashboard.week) %></p>
    </header>

    <div class="grid grid-cols-1 gap-6 xl:grid-cols-3">
      <div class="min-w-0 space-y-6 xl:col-span-2">
        <section aria-label="<%= t(:dashboard_weekly_activity) %>" class="grid grid-cols-1 gap-4 sm:grid-cols-3">
          <% @dashboard.activity.each do |metric, (current, _previous)| %>
            <div class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm">
              <h2 class="text-sm font-medium text-gray-600"><%= t("dashboard_#{metric}") %></h2>
              <p class="mt-2 text-4xl font-semibold text-purple-900"><%= current %></p>
            </div>
          <% end %>
        </section>

        <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm" aria-labelledby="daily-activity-title">
          <h2 id="daily-activity-title" class="text-lg font-semibold text-purple-900"><%= t(:dashboard_daily_lessons) %></h2>
          <% daily = @dashboard.daily_lessons %>
          <div class="mt-4 hidden h-52" data-dashboard-chart-wrapper>
            <canvas id="dashboard-daily-lessons" data-dashboard-chart="daily" data-chart-label="<%= t(:dashboard_lessons) %>"
                    data-chart-values="<%= daily.map { |entry| entry[:count] }.to_json %>"
                    data-chart-labels="<%= daily.map { |entry| l(entry[:date], format: :short) }.to_json %>"
                    role="img" aria-label="<%= t(:dashboard_daily_lessons) %>"></canvas>
          </div>
        </section>
      </div>
      <%= render 'groups' %>
    </div>

    <div class="mt-8 grid grid-cols-1 items-start gap-6 xl:grid-cols-2">
      <%= render 'patterns', title: t(:dashboard_closer_look), patterns: @dashboard.declines, empty: t(:dashboard_no_declines), direction: :decline %>
      <%= render 'patterns', title: t(:dashboard_celebrate), patterns: @dashboard.improvements, empty: t(:dashboard_no_improvements), direction: :improvement %>
    </div>

    <%= render 'snapshot' %>
    <script>
      window.onChartsLoad = function() {
        displayDashboardCharts && displayDashboardCharts();
      }
    </script>
    <%= javascript_include_tag 'new_charts', onload: 'window.onChartsLoad && window.onChartsLoad()' %>
  <% end %>
</main>
