<%= turbo_stream.replace 'modal' do %>
  <div id="modal" class="relative z-10" aria-labelledby="modal-title" role="dialog" aria-modal="true" data-controller="modal">
    <div class="fixed inset-0 bg-gray-500/50 transition-opacity backdrop-out transform-gpu" data-modal-target="backdrop"></div>
    <div class="fixed inset-0 z-10 w-screen overflow-y-auto" data-action="click->modal#close">
      <div class="flex min-h-full items-end justify-center p-4 sm:items-center sm:p-0">
        <div class="modal-out transition-all transform-gpu" data-modal-target="modal" data-action="click->modal#stopPropagation">
          <%= render CommonComponents::Card.new(title: t(:assign_tags_to_students)) do |card| %>
            <% card.with_card_content do %>
              <%= form_with url: confirm_tag_assignment_group_path(@group), html: { method: :post, class: 'bg-white p-4' } do %>
                <p class="text-sm text-gray-500 mb-3"><%= t(:assign_tags_to_group_explanation, count: @active_student_count) %></p>
                <div data-controller="student-tag" data-student-tag-delete-image-url-value="<%= image_url "delete_forever.svg" %>">
                  <div id="tag-container" data-student-tag-target="container"></div>
                  <label for="tags-field" class="block text-sm font-medium text-gray-700"><%= t(:tags) %></label>
                  <%= select_tag 'tag_ids[]', options_from_collection_for_select(@permitted_tags, :id, :tag_name), multiple: true, class: 'hidden', id: 'tags-field', 'data-student-tag-target' => 'tags' %>
                  <%= text_field_tag 'tags_autocomplete', nil, id: 'tag-autocomplete', 'data-student-tag-target' => 'autocomplete', class: 'mt-1 block w-full rounded-md border-purple-500 shadow-sm focus:border-green-600 focus:ring-green-600 sm:text-sm', role: 'combobox', 'aria-controls' => 'options', 'aria-expanded' => false %>
                  <div class="pt-4">
                    <%= submit_tag t(:assign), class: 'button normal-button', disabled: true, 'data-student-tag-target' => 'submit' %>
                    <div class="dangerous-button" data-action="click->modal#close"><%= t(:cancel) %></div>
                  </div>
                </div>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>
